#!/usr/bin/env python3
"""Call tools on the Beautiful.ai MCP server
(https://openai-mcp-696419881849.us-central1.run.app/mcp).

Usage:
  beautiful-mcp tools/list
  beautiful-mcp tools/call list_presentations
  beautiful-mcp tools/call create_presentation '{"title": "...", "slides": [...]}'

Prints the JSON-RPC result object. Auth uses the OAuth tokens stored in
~/.openai-mcp/oauth.json (created by the initial connect flow the user
approved); the access token is refreshed automatically when it expires.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request

MCP_URL = "https://openai-mcp-696419881849.us-central1.run.app/mcp"
TOKEN_URL = "https://www.beautiful.ai/provisioning/oauth2/token"
OAUTH_FILE = os.path.expanduser("~/workspace/.openai-mcp/oauth.json")
PROTOCOL_VERSION = "2024-11-05"
TIMEOUT = 60


def load_oauth() -> dict:
    with open(OAUTH_FILE) as f:
        return json.load(f)


def save_oauth(oauth: dict) -> None:
    os.chmod(OAUTH_FILE, 0o600)
    with open(OAUTH_FILE, "w") as f:
        json.dump(oauth, f)


def refresh(oauth: dict) -> dict:
    data = urllib.parse.urlencode({
        "grant_type": "refresh_token",
        "refresh_token": oauth["refresh_token"],
        "client_id": oauth["client_id"],
    }).encode()
    req = urllib.request.Request(
        TOKEN_URL, data=data, method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded",
                 "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) Chrome/126.0"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        tok = json.load(resp)
    oauth["access_token"] = tok["access_token"]
    if tok.get("refresh_token"):
        oauth["refresh_token"] = tok["refresh_token"]
    save_oauth(oauth)
    return oauth


def post(payload: dict, token: str):
    # curl transport: the server truncates long bodies on urllib but curl
    # reads them reliably.
    body = json.dumps(payload)
    proc = subprocess.run(
        ["curl", "-sS", "-m", str(TIMEOUT), "-X", "POST", MCP_URL,
         "-H", "Content-Type: application/json",
         "-H", "Accept: application/json, text/event-stream",
         "-H", "MCP-Protocol-Version: " + PROTOCOL_VERSION,
         "-H", "Authorization: Bearer " + token,
         "-d", body, "-w", "\n%{http_code}"],
        capture_output=True, text=True, timeout=TIMEOUT + 10)
    if proc.returncode != 0:
        raise RuntimeError(f"curl failed: {proc.stderr[:300]}")
    out = proc.stdout.rsplit("\n", 1)
    raw, status = out[0], int(out[1].strip() or 0)
    if status in (401, 403):
        raise PermissionError("unauthorized")
    if status >= 400:
        raise RuntimeError(f"MCP HTTP {status}: {raw[:300]}")
    messages = []
    try:
        messages.append(json.loads(raw))
    except json.JSONDecodeError:
        for line in raw.splitlines():
            if line.startswith("data:"):
                try:
                    messages.append(json.loads(line[5:].strip()))
                except json.JSONDecodeError:
                    pass
    return status, messages


def call_mcp(method: str, params: dict):
    oauth = load_oauth()
    payload = {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}
    try:
        _, msgs = post(payload, oauth["access_token"])
    except PermissionError:
        oauth = refresh(oauth)
        _, msgs = post(payload, oauth["access_token"])
    return msgs


def main(argv: list[str]) -> int:
    if not argv or "/" not in argv[0]:
        print("usage: beautiful-mcp <method> [json-params]", file=sys.stderr)
        print("  methods: tools/list, tools/call <tool-name>", file=sys.stderr)
        return 2
    method = argv[0]
    if method == "tools/list":
        params: dict = {}
    elif method == "tools/call":
        if len(argv) < 2:
            print("usage: beautiful-mcp tools/call <tool-name> [json-args]",
                  file=sys.stderr)
            return 2
        params = {"name": argv[1],
                  "arguments": json.loads(argv[2]) if len(argv) > 2 else {}}
    else:
        print(f"unsupported method: {method}", file=sys.stderr)
        return 2

    # initialize handshake
    call_mcp("initialize", {
        "protocolVersion": PROTOCOL_VERSION, "capabilities": {},
        "clientInfo": {"name": "cane", "version": "1.0"}})
    try:
        call_mcp("notifications/initialized", {})
    except Exception:
        pass

    for msg in call_mcp(method, params):
        if "result" in msg:
            print(json.dumps(msg["result"], indent=2))
        elif "error" in msg:
            print("ERROR: " + json.dumps(msg["error"])[:1000], file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
