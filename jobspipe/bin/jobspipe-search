#!/usr/bin/env python3
"""Search JobsPipe live job postings via the authenticated REST API.

Usage examples:
  jobspipe-search --title "Head of Partnerships" --title "Director of Partnerships" \\
      --remote --country US --max-age-days 7 --limit 50
  jobspipe-search --title "VP Partnerships" --keywords "channel,alliance" --min-salary-usd 130000

Prints one JSON object per line with the normalized fields that matter for
triage: title, company, location, compensation (USD-normalized when available),
date_posted, apply url, sources, ghost_score.
Auth uses the stored custom.jobspipe connector via dynamic credential surrogates;
no raw key is ever handled here. 1 credit = 1 new job returned per calendar month.
"""

from __future__ import annotations

import argparse
import json
import sys
import urllib.request

sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
from dynamic_credentials import (  # noqa: E402
    add_surrogate_to_request,
    read_json_response,
)

API_HOST = "api.jobspipe.dev"
SEARCH_URL = f"https://{API_HOST}/v1/jobs/search"
CREDENTIAL_NAME = "custom.jobspipe"
ALLOWED_HOSTS = [API_HOST, "mcp.jobspipe.dev"]
TIMEOUT = 90


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Search JobsPipe job postings")
    p.add_argument("--title", action="append", default=[],
                   help="Job title to match (repeatable, OR semantics)")
    p.add_argument("--keywords", default="",
                   help="Comma-separated description keywords (OR semantics)")
    p.add_argument("--company", action="append", default=[],
                   help="Partial company name match (repeatable)")
    p.add_argument("--remote", action="store_true",
                   help="Only remote roles")
    p.add_argument("--country", action="append", default=[],
                   help="Country code filter, e.g. US (repeatable)")
    p.add_argument("--location", action="append", default=[],
                   help="Location string filter (repeatable)")
    p.add_argument("--max-age-days", type=int, default=0,
                   help="Only postings from the last N days (0 = no limit)")
    p.add_argument("--source-or", default="",
                   help="Comma-separated sources to include, e.g. greenhouse,lever")
    p.add_argument("--source-not", default="",
                   help="Comma-separated sources to exclude, e.g. indeed")
    p.add_argument("--min-salary-usd", type=int, default=0,
                   help="Client-side filter on min annual salary in USD "
                        "(uses estimated USD fields when stated salary is absent; 0 = off)")
    p.add_argument("--limit", type=int, default=50,
                   help="Max results to print (default 50)")
    return p.parse_args(argv)


def build_query(args: argparse.Namespace) -> dict:
    query: dict = {}
    if args.title:
        query["job_title_or"] = args.title
    if args.keywords:
        query["description_or"] = [k.strip() for k in args.keywords.split(",") if k.strip()]
    if args.company:
        query["company_name_partial_match_or"] = args.company
    if args.remote:
        query["remote"] = True
    if args.country:
        query["job_country_code_or"] = args.country
    if args.location:
        query["job_location_or"] = args.location
    if args.max_age_days > 0:
        query["posted_at_max_age_days"] = args.max_age_days
    if args.source_or:
        query["source_or"] = [s.strip() for s in args.source_or.split(",") if s.strip()]
    if args.source_not:
        query["source_not"] = [s.strip() for s in args.source_not.split(",") if s.strip()]
    return query


def search(query: dict) -> dict:
    body = json.dumps(query).encode("utf-8")
    req = urllib.request.Request(
        SEARCH_URL, data=body, method="POST",
        headers={"Content-Type": "application/json"},
    )
    add_surrogate_to_request(req, CREDENTIAL_NAME, allowed_hosts=ALLOWED_HOSTS)
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return read_json_response(resp)


def usd_min(job: dict):
    for key in ("min_annual_salary_usd", "estimated_min_annual_salary_usd",
                "min_annual_salary"):
        v = job.get(key)
        if isinstance(v, (int, float)) and v > 0:
            return v
    return None


def slim(job: dict) -> dict:
    sources = job.get("sources") or []
    comp_min = job.get("min_annual_salary")
    comp_max = job.get("max_annual_salary")
    return {
        "title": job.get("job_title"),
        "company": job.get("company"),
        "company_domain": job.get("company_domain"),
        "location": job.get("short_location") or job.get("location"),
        "remote": job.get("remote"),
        "work_arrangement": job.get("work_arrangement"),
        "salary": {
            "min_usd": job.get("min_annual_salary_usd") or job.get("estimated_min_annual_salary_usd"),
            "max_usd": job.get("max_annual_salary_usd") or job.get("estimated_max_annual_salary_usd"),
            "stated_min": comp_min,
            "stated_max": comp_max,
            "currency": job.get("salary_currency"),
            "string": job.get("salary_string"),
        },
        "seniority": job.get("seniority"),
        "date_posted": job.get("date_posted"),
        "apply_url": job.get("final_url") or job.get("url"),
        "sources": [s.get("provider") for s in sources if isinstance(s, dict)],
        "ghost_score": job.get("ghost_score"),
        "status": job.get("status"),
    }


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    try:
        data = search(build_query(args))
    except Exception as exc:  # noqa: BLE001 - surface provider/auth errors plainly
        print(f"jobspipe-search: request failed: {exc}", file=sys.stderr)
        return 1

    jobs = data.get("data") or []
    meta = data.get("metadata") or {}
    shown = 0
    for job in jobs:
        if not isinstance(job, dict):
            continue
        if args.min_salary_usd > 0:
            lo = usd_min(job)
            if lo is None or lo < args.min_salary_usd:
                continue
        print(json.dumps(slim(job), ensure_ascii=False))
        shown += 1
        if shown >= args.limit:
            break
    print(f"jobspipe-search: {shown} shown of {len(jobs)} returned "
          f"(credits_charged={meta.get('credits_charged')})", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
