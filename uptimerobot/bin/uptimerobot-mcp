#!/usr/bin/env python3
"""Call tools on UptimeRobot's MCP server (https://mcp.uptimerobot.com/mcp).

Usage:
  uptimerobot-mcp tools/list
  uptimerobot-mcp tools/call getMonitors
  uptimerobot-mcp tools/call getMonitors '{"statuses": [9]}'

Prints the JSON-RPC result object. Auth uses the stored custom.uptimerobot
connector via dynamic credential surrogates; no raw token is handled here.
"""

from __future__ import annotations

import json
import sys
import urllib.request

sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
from dynamic_credentials import (  # noqa: E402
    add_surrogate_to_request,
    read_response_body,
)

MCP_URL = "https://mcp.uptimerobot.com/mcp"
CREDENTIAL_NAME = "custom.uptimerobot"
ALLOWED_HOSTS = ["mcp.uptimerobot.com"]
TIMEOUT = 60


def post(payload: dict, session_id: str | None = None) -> tuple[str | None, list]:
    body = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        MCP_URL, data=body, method="POST",
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "User-Agent": "muse-assistant-uptimerobot-skill/1.0",
        },
    )
    if session_id:
        req.add_header("Mcp-Session-Id", session_id)
    add_surrogate_to_request(req, CREDENTIAL_NAME, allowed_hosts=ALLOWED_HOSTS)
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        raw = read_response_body(resp).decode("utf-8", errors="replace")
        sid = resp.headers.get("Mcp-Session-Id")
    messages = []
    try:
        messages.append(json.loads(raw))
    except json.JSONDecodeError:
        for line in raw.splitlines():
            if line.startswith("data:"):
                try:
                    messages.append(json.loads(line[5:].strip()))
                except json.JSONDecodeError:
                    pass
    return sid, messages


def main(argv: list[str]) -> int:
    if len(argv) < 1 or "/" not in argv[0]:
        print("usage: uptimerobot-mcp <method> [json-params]", file=sys.stderr)
        print("  methods: tools/list, tools/call <tool-name>", file=sys.stderr)
        return 2
    method = argv[0]
    params: dict = {}
    if method == "tools/call":
        if len(argv) < 2:
            print("usage: uptimerobot-mcp tools/call <tool-name> [json-args]", file=sys.stderr)
            return 2
        params = {"name": argv[1],
                  "arguments": json.loads(argv[2]) if len(argv) > 2 else {}}
    elif method != "tools/list":
        print(f"unsupported method: {method}", file=sys.stderr)
        return 2

    sid, msgs = post({
        "jsonrpc": "2.0", "id": 1, "method": "initialize",
        "params": {"protocolVersion": "2025-06-18", "capabilities": {},
                   "clientInfo": {"name": "cane", "version": "1.0"}},
    })
    if not msgs or "result" not in msgs[0]:
        print(f"initialize failed: {msgs}", file=sys.stderr)
        return 1
    try:
        post({"jsonrpc": "2.0", "method": "notifications/initialized"}, sid)
    except Exception:  # noqa: BLE001 - notification has no response; ignore errors
        pass

    _, msgs = post({"jsonrpc": "2.0", "id": 2, "method": method,
                    "params": params}, sid)
    if not msgs:
        print("no response messages", file=sys.stderr)
        return 1
    msg = msgs[0]
    if "error" in msg:
        print(json.dumps(msg["error"], indent=2), file=sys.stderr)
        return 1
    print(json.dumps(msg.get("result"), indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

